# --- GENERAL DOC SETTINGS ---
EXTRACT_ALL             = YES
EXTRACT_PRIVATE         = YES
EXTRACT_STATIC          = YES
HIDE_UNDOC_MEMBERS      = NO
HIDE_UNDOC_CLASSES      = NO
SHOW_INCLUDE_FILES      = YES
INPUT                   = src src/Connections src/Control include/Connections include/Control README.md
EXCLUDE                 = Secret/
FILE_PATTERNS           = *.cpp *.hpp *.md *.svg
RECURSIVE               = YES
EXCLUDE_PATTERNS = */secret/* */Secrets.hpp
IMAGE_PATH = data
PROJECT_NAME = "Glove-based Orientation and Articulation Tracker"



# --- DOT / CLASS DIAGRAMS ---
HAVE_DOT                = YES
CLASS_GRAPH             = YES
COLLABORATION_GRAPH     = YES
TEMPLATE_RELATIONS      = YES
UML_LOOK                = YES
UML_LIMIT_NUM_FIELDS    = 50
DOT_GRAPH_MAX_NODES     = 100
MAX_DOT_GRAPH_DEPTH     = 0
DOT_IMAGE_FORMAT        = svg
INTERACTIVE_SVG         = YES
DOT_CLEANUP             = YES

# --- PREPROCESSING ---
ENABLE_PREPROCESSING    = YES
MACRO_EXPANSION         = YES
EXPAND_ONLY_PREDEF      = NO

# --- MARKDOWN & MAIN PAGE ---
MARKDOWN_SUPPORT        = YES
USE_MDFILE_AS_MAINPAGE  = README.md

# --- PLANTUML INTEGRATION ---
PLANTUML_JAR_PATH       = /opt/homebrew/Cellar/plantuml/1.2025.2/libexec/plantuml.jar
PLANTUML_CFG_FILE       =
PLANTUML_INCLUDE_PATH   = .
PLANTUMLFILE_DIRS       =
